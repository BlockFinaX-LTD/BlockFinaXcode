{
  "name": "blockfinax-integrator-api",
  "version": "1.0.0",
  "private": true,
  "description": "Public REST API for the BlockFinaX parametric-FX-protection protocol. Deploy this independently of the main BlockFinaX app — third parties (or other internal services) consume it for reads, calldata-building, and protocol orchestration.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.0.0",
    "@neondatabase/serverless": "^0.10.4",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.39.1",
    "ethers": "^6.13.4",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "pg": "^8.16.3",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/ws": "^8.5.13",
    "@vitest/coverage-v8": "^4.1.6",
    "supertest": "^7.2.2",
    "tsx": "^4.19.1",
    "typescript": "^5.7.2",
    "vitest": "^4.1.6"
  }
}
