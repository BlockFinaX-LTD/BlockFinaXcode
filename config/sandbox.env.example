# Isolated sandbox pricing service. Does not run the main server or its workers.
APP_ENV=sandbox
NETWORK_MODE=testnet
NODE_ENV=production
PORT=5001
DATABASE_URL=
SANDBOX_RPC_URL=https://sepolia.base.org
SANDBOX_DIAMOND_ADDRESS=
SANDBOX_PRICING_PRIVATE_KEY=
# Do not set production deployer, treasury, Rift, Resend, or pricing credentials.
