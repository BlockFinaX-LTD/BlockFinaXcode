# Public frontend configuration only. Do not put Rift secret keys here.
# Vite reads env files under client/; use client/.env.testnet.local.
VITE_NETWORK_MODE=testnet
# Leave these two blank to reuse the current BlockFinaX sign-in project.
# Supply the existing VITE_RIFT_PUBLIC_KEY and optional VITE_RIFT_WIDGET_URL
# through your usual environment configuration; do not copy keys into source.
VITE_SANDBOX_RIFT_PUBLIC_KEY=
VITE_SANDBOX_RIFT_WIDGET_URL=
VITE_SANDBOX_RIFT_SDK_URL=
VITE_SANDBOX_RIFT_SIGNING_URL=
# Awaiting Rift-confirmed chain name for Base Sepolia (84532).
# Sign-in accepts a publishable pk_ key only. Existing secret sk_ keys are not copied.
# Contract writes and transfers remain blocked until Rift testnet signing is wired.
VITE_SANDBOX_USD_ADDRESS=
VITE_SANDBOX_DIAMOND_ADDRESS=
APP_ENV=sandbox
NODE_ENV=production
PORT=5002
SANDBOX_RPC_URL=https://sepolia.base.org
