{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npx esbuild server/sandbox/index.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/sandbox.js"
  },
  "deploy": {
    "startCommand": "node dist/sandbox.js",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
