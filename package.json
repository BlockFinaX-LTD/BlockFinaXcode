{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx server/index.ts",
    "dev:testnet": "sh scripts/dev-testnet.sh",
    "demo:video": "tsx scripts/demo-video/record.ts",
    "org:check": "tsx scripts/organisations/testnet-check.ts && tsx scripts/organisations/testnet-service-check.ts",
    "db:push:testnet-local": "sh scripts/dev-testnet.sh push",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "test": "find server shared client/src -name \"*.test.ts\" -not -path \"*/node_modules/*\" -print0 | xargs -0 tsx --test",
    "db:push": "drizzle-kit push",
    "pricing:test": "tsx --test server/pricing/__tests__/*.test.ts",
    "predict:test": "tsx --test server/predict/__tests__/*.test.ts",
    "funding:test": "tsx --test server/funding/__tests__/*.test.ts",
    "agent:test": "tsx --test server/agent/__tests__/*.test.ts",
    "lib:test": "tsx --test server/lib/__tests__/*.test.ts",
    "client:test": "tsx --test client/src/lib/__tests__/*.test.ts",
    "outreach:test": "tsx --env-file-if-exists=.env --test server/routes/__tests__/*.test.ts",
    "outreach:migrate": "tsx --env-file-if-exists=.env server/scripts/migrate-outreach.ts",
    "prospects:test": "tsx --env-file-if-exists=.env --test server/prospects/__tests__/*.test.ts",
    "prospects:migrate": "tsx --env-file-if-exists=.env server/scripts/migrate-prospects.ts",
    "pricing:price": "tsx --env-file-if-exists=.env server/pricing/scripts/price-cli.ts",
    "pricing:bootstrap": "tsx --env-file=.env server/pricing/scripts/bootstrap.ts",
    "pricing:backfill-30y": "tsx --env-file=.env server/pricing/scripts/backfill-30y.ts",
    "pricing:calibrate-jumps": "tsx --env-file=.env server/pricing/scripts/calibrate-jumps.ts",
    "pricing:calibrate-garch": "tsx --env-file=.env server/pricing/scripts/calibrate-garch.ts",
    "pricing:backtest": "tsx --env-file=.env server/pricing/scripts/backtest.ts",
    "pricing:scan-onchain": "tsx server/pricing/scripts/scan-onchain-pairs.ts",
    "pricing:scan-everything": "tsx server/pricing/scripts/scan-onchain-everything.ts",
    "build:wallet-sandbox": "cross-env VITE_NETWORK_MODE=testnet vite build --mode testnet && esbuild server/sandbox/wallet.ts --platform=node --packages=external --bundle --format=esm --outfile=dist/wallet-sandbox.js",
    "test:wallet-sandbox": "tsx --test server/sandbox/__tests__/wallet-app.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@neondatabase/serverless": "^0.10.4",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-progress": "^1.1.3",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.1.4",
    "@radix-ui/react-tabs": "^1.1.4",
    "@radix-ui/react-toast": "^1.2.7",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.0",
    "@stellar/stellar-sdk": "^16.4.1",
    "@tanstack/react-query": "^5.60.5",
    "@types/multer": "^2.1.0",
    "@types/qrcode": "^1.5.5",
    "@walletconnect/ethereum-provider": "^2.21.1",
    "buffer": "6.0.3",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.39.1",
    "drizzle-zod": "^0.7.0",
    "eruda": "^3.4.3",
    "ethers": "^6.14.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.2",
    "framer-motion": "^11.13.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^8.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.453.0",
    "mermaid": "^11.15.0",
    "multer": "^2.1.1",
    "passkey-kit": "0.14.0",
    "passkey-kit-sdk": "0.8.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.4",
    "smart-account-kit": "^0.10.0",
    "solc": "^0.8.34",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "wouter": "^3.3.5",
    "ws": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@ethereumjs/vm": "^10.1.3",
    "@tailwindcss/typography": "^0.5.15",
    "@types/express": "4.17.21",
    "@types/node": "20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.30.4",
    "esbuild": "^0.25.0",
    "ffmpeg-static": "^5.2.0",
    "playwright": "^1.64.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.1",
    "typescript": "5.6.3",
    "vite": "^5.4.15"
  },
  "optionalDependencies": {
    "bufferutil": "^4.0.8"
  },
  "overrides": {
    "passkey-kit": {
      "@stellar/stellar-sdk": "$@stellar/stellar-sdk"
    }
  }
}
